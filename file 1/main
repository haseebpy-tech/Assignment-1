// CSC211 Data Structures - Assignment 1 (Lab)
// Singly, Doubly and Circular Linked List tasks

#include <iostream>                      // for cout
#include <string>                        // for string
using namespace std;                     // so we do not write std:: everywhere

// ======================= SINGLY LINKED LIST =======================

struct Node {                            // node of singly linked list
    int data;                            // value stored in node
    Node* next;                          // address of next node
};

Node* makeNode(int x) {                  // creates a new node with value x
    Node* n = new Node;                  // allocate memory
    n->data = x;                         // store the value
    n->next = NULL;                      // not pointing anywhere yet
    return n;                            // give back the new node
}

void addEnd(Node*& head, int x) {        // adds a node at the end of list
    Node* n = makeNode(x);               // make the new node
    if (head == NULL) {                  // if list is empty
        head = n;                        // new node becomes head
        return;                          // done
    }
    Node* t = head;                      // start from head
    while (t->next != NULL)              // go till last node
        t = t->next;                     // move forward
    t->next = n;                         // attach new node at the end
}

void show(Node* head) {                  // prints the list
    while (head != NULL) {               // till list ends
        cout << head->data << " -> ";    // print value
        head = head->next;               // move forward
    }
    cout << "NULL" << endl;              // end of list
}

void freeList(Node* head) {              // deletes the whole list
    while (head != NULL) {               // till list ends
        Node* t = head;                  // remember current node
        head = head->next;               // move forward first
        delete t;                        // then delete the old one
    }
}

// ---- Task 1: print list in reverse without changing it ----
// Algorithm: go to the last node using recursion, print when coming back
void printReverse(Node* head) {
    if (head == NULL)                    // base case, list finished
        return;                          // go back
    printReverse(head->next);            // first go to the rest of list
    cout << head->data << " ";           // print after coming back
}

// ---- Task 2: reverse the list (only links change) ----
// Algorithm: keep prev, cur, nxt and make every node point to its previous node
Node* reverseList(Node* head) {
    Node* prev = NULL;                   // node before current
    Node* cur = head;                    // current node
    while (cur != NULL) {                // till we pass last node
        Node* nxt = cur->next;           // save next node
        cur->next = prev;                // reverse the link
        prev = cur;                      // move prev forward
        cur = nxt;                       // move cur forward
    }
    return prev;                         // prev is the new head
}

// ---- Task 3 and 8: remove duplicates ----
// Algorithm: for each node, check all nodes after it and delete the same values
void removeDuplicates(Node* head) {
    Node* cur = head;                    // node we are checking
    while (cur != NULL) {                // for every node
        Node* run = cur;                 // run goes through remaining nodes
        while (run->next != NULL) {      // till end of list
            if (run->next->data == cur->data) {   // duplicate found
                Node* dup = run->next;   // node to delete
                run->next = dup->next;   // skip the duplicate
                delete dup;              // free its memory
            } else {
                run = run->next;         // no duplicate, move forward
            }
        }
        cur = cur->next;                 // check next node
    }
}

// ---- Task 4: detect loop ----
// Algorithm: slow moves 1 step, fast moves 2 steps. If they meet there is a loop
bool hasLoop(Node* head) {
    Node* slow = head;                   // moves one step
    Node* fast = head;                   // moves two steps
    while (fast != NULL && fast->next != NULL) {   // fast reaches NULL if no loop
        slow = slow->next;               // one step
        fast = fast->next->next;         // two steps
        if (slow == fast)                // both at same node
            return true;                 // loop exists
    }
    return false;                        // reached the end so no loop
}

// ---- Task 5: middle node (left one if even) ----
// Algorithm: slow and fast pointer, stop when fast has no two nodes ahead
Node* findMiddle(Node* head) {
    if (head == NULL)                    // empty list
        return NULL;                     // no middle
    Node* slow = head;                   // moves one step
    Node* fast = head;                   // moves two steps
    while (fast->next != NULL && fast->next->next != NULL) {   // two nodes ahead
        slow = slow->next;               // one step
        fast = fast->next->next;         // two steps
    }
    return slow;                         // slow is at the middle
}

// ---- Task 6: separate even and odd values ----
// Algorithm: take each node out of the list and add it to even or odd list
void splitEvenOdd(Node* head, Node*& even, Node*& odd) {
    even = NULL;                         // even list is empty at start
    odd = NULL;                          // odd list is empty at start
    Node* eTail = NULL;                  // last node of even list
    Node* oTail = NULL;                  // last node of odd list
    while (head != NULL) {               // go through whole list
        Node* nxt = head->next;          // save next node
        head->next = NULL;               // cut it from the list
        if (head->data % 2 == 0) {       // even value
            if (even == NULL) {          // first even node
                even = head;             // it is head of even list
                eTail = head;            // and also its tail
            } else {
                eTail->next = head;      // add at the end
                eTail = head;            // update tail
            }
        } else {                         // odd value
            if (odd == NULL) {           // first odd node
                odd = head;              // it is head of odd list
                oTail = head;            // and also its tail
            } else {
                oTail->next = head;      // add at the end
                oTail = head;            // update tail
            }
        }
        head = nxt;                      // go to next node
    }
}

// ---- Task 7: reverse first half and second half separately ----
// Algorithm: count nodes, reverse first n/2 nodes, then reverse the rest and join
Node* reverseHalves(Node* head) {
    int n = 0;                           // total nodes
    Node* t = head;                      // pointer for counting
    while (t != NULL) {                  // count the nodes
        n++;                             // one more node
        t = t->next;                     // move forward
    }
    if (n < 2)                           // nothing to reverse
        return head;                     // same list
    int half = n / 2;                    // size of first half
    Node* prev = NULL;                   // node before current
    Node* cur = head;                    // current node
    for (int i = 0; i < half; i++) {     // reverse first half only
        Node* nxt = cur->next;           // save next node
        cur->next = prev;                // reverse the link
        prev = cur;                      // move prev forward
        cur = nxt;                       // move cur forward
    }
    head->next = reverseList(cur);       // old head is now tail, join reversed second half
    return prev;                         // prev is the new head
}

// ---- Task 9: delete all nodes having a given id ----
// Algorithm: first remove from the head, then remove from middle and end
Node* deleteAll(Node* head, int key) {
    while (head != NULL && head->data == key) {   // key at the beginning (can be many)
        Node* t = head;                  // node to delete
        head = head->next;               // move head forward
        delete t;                        // free memory
    }
    Node* cur = head;                    // now check the rest
    while (cur != NULL && cur->next != NULL) {    // look at the next node each time
        if (cur->next->data == key) {    // next node has the key
            Node* t = cur->next;         // node to delete
            cur->next = t->next;         // skip it
            delete t;                    // free memory
        } else {
            cur = cur->next;             // move forward
        }
    }
    return head;                         // head may have changed
}

// ---- Task 10: swap every two consecutive nodes ----
// Algorithm: take a pair, change its links, then go to the next pair
Node* swapPairs(Node* head) {
    Node** link = &head;                 // address of the link that points to current pair
    while (*link != NULL && (*link)->next != NULL) {   // need two nodes
        Node* a = *link;                 // first node of pair
        Node* b = a->next;               // second node of pair
        a->next = b->next;               // a goes after b
        b->next = a;                     // b goes before a
        *link = b;                       // previous part now points to b
        link = &(a->next);               // go to next pair
    }
    return head;                         // new head of list
}

// ======================= DOUBLY LINKED LIST =======================

struct DNode {                           // node of doubly linked list
    string data;                         // value stored
    DNode* prev;                         // previous node
    DNode* next;                         // next node
};

void dAdd(DNode*& head, DNode*& tail, string x) {   // adds node at the end
    DNode* n = new DNode;                // new node
    n->data = x;                         // store value
    n->prev = tail;                      // previous is current tail
    n->next = NULL;                      // nothing after it
    if (head == NULL)                    // list was empty
        head = n;                        // it is the head
    else
        tail->next = n;                  // link old tail to new node
    tail = n;                            // new node is the tail now
}

void dShow(DNode* head) {                // prints list forward
    while (head != NULL) {               // till end
        cout << head->data << " <-> ";   // print value
        head = head->next;               // move forward
    }
    cout << "NULL" << endl;              // end of list
}

void dFree(DNode* head) {                // deletes whole list
    while (head != NULL) {               // till end
        DNode* t = head;                 // remember node
        head = head->next;               // move forward
        delete t;                        // delete old node
    }
}

// ---- DLL Task 1: swap desks from both ends ----
// Algorithm: one pointer from front, one from back, swap and move towards centre
void swapDesks(DNode* head, DNode* tail) {
    DNode* l = head;                     // left pointer
    DNode* r = tail;                     // right pointer
    while (l != r && l->prev != r) {     // stop when they meet or cross
        string temp = l->data;           // swap the two values
        l->data = r->data;               // left gets right value
        r->data = temp;                  // right gets left value
        l = l->next;                     // left moves forward
        r = r->prev;                     // right moves backward
    }
}

// ---- DLL Task 2: music player playlist ----
DNode* pHead = NULL;                     // first song
DNode* pTail = NULL;                     // last song
DNode* pCur = NULL;                      // song that is playing now

void addSong(string name) {              // add a song at the end
    dAdd(pHead, pTail, name);            // use the same add function
    if (pCur == NULL)                    // if nothing was playing
        pCur = pHead;                    // start from first song
}

void removeSong(string name) {           // remove a song by name
    DNode* t = pHead;                    // start from first song
    while (t != NULL && t->data != name) // search for the song
        t = t->next;                     // move forward
    if (t == NULL) {                     // not found
        cout << "Song not found" << endl;
        return;                          // nothing to delete
    }
    if (t == pCur) {                     // deleting the playing song
        if (t->next != NULL)             // if there is a next song
            pCur = t->next;              // play next
        else
            pCur = t->prev;              // otherwise go to previous
    }
    if (t->prev != NULL)                 // not the first node
        t->prev->next = t->next;         // previous skips t
    else
        pHead = t->next;                 // head changes
    if (t->next != NULL)                 // not the last node
        t->next->prev = t->prev;         // next skips t
    else
        pTail = t->prev;                 // tail changes
    delete t;                            // free memory
}

void nowPlaying() {                      // shows current song
    if (pCur == NULL)                    // empty playlist
        cout << "Playlist is empty" << endl;
    else
        cout << "Now playing: " << pCur->data << endl;
}

void nextSong() {                        // go to next song
    if (pCur != NULL && pCur->next != NULL)   // if next exists
        pCur = pCur->next;               // move forward
    else
        cout << "(no next song) ";       // already at last song
    nowPlaying();                        // show the song
}

void prevSong() {                        // go to previous song
    if (pCur != NULL && pCur->prev != NULL)   // if previous exists
        pCur = pCur->prev;               // move backward
    else
        cout << "(no previous song) ";   // already at first song
    nowPlaying();                        // show the song
}

// ---- DLL Task 3: inventory system ----
// Store list -> each store has section list -> each section has item list
struct Item {                            // an item in a section
    string name;                         // item name
    int qty;                             // quantity
    Item* next;                          // next item
};

struct Section {                         // a section like toys, grocery
    string name;                         // section name
    Item* items;                         // list of items in this section
    Section* next;                       // next section
};

struct Store {                           // a store in some city
    string name;                         // store name
    string city;                         // city of the store
    Section* sections;                   // list of sections in this store
    Store* next;                         // next store
};

Store* stores = NULL;                    // head of the store list

void addStore(string name, string city) {   // add a new store
    Store* s = new Store;                // new store node
    s->name = name;                      // set name
    s->city = city;                      // set city
    s->sections = NULL;                  // no sections yet
    s->next = stores;                    // add at the front of list
    stores = s;                          // it is the new head
}

Store* findStore(string name) {          // search store by name
    Store* t = stores;                   // start from first store
    while (t != NULL && t->name != name) // till found
        t = t->next;                     // move forward
    return t;                            // NULL if not found
}

Section* findSection(Store* st, string name) {   // search section in a store
    Section* t = st->sections;           // start from first section
    while (t != NULL && t->name != name) // till found
        t = t->next;                     // move forward
    return t;                            // NULL if not found
}

void addSection(string store, string section) {  // add section in a store
    Store* st = findStore(store);        // find the store
    if (st == NULL) {                    // store does not exist
        cout << "Store not found" << endl;
        return;                          // stop
    }
    if (findSection(st, section) != NULL) {      // already there
        cout << "Section already exists" << endl;
        return;                          // stop
    }
    Section* s = new Section;            // new section node
    s->name = section;                   // set name
    s->items = NULL;                     // no items yet
    s->next = st->sections;              // add at the front
    st->sections = s;                    // it is the new head
}

void addItem(string store, string section, string item, int qty) {   // store an item
    Store* st = findStore(store);        // find the store first
    if (st == NULL) {                    // not found
        cout << "Store not found" << endl;
        return;                          // stop
    }
    Section* sc = findSection(st, section);      // then find the section
    if (sc == NULL) {                    // not found
        cout << "Section not found" << endl;
        return;                          // stop
    }
    Item* t = sc->items;                 // check if item already exists
    while (t != NULL && t->name != item) // search
        t = t->next;                     // move forward
    if (t != NULL) {                     // item exists
        t->qty = t->qty + qty;           // just increase quantity
        return;                          // done
    }
    Item* n = new Item;                  // new item node
    n->name = item;                      // set name
    n->qty = qty;                        // set quantity
    n->next = sc->items;                 // add at the front
    sc->items = n;                       // it is the new head
}

void removeItem(string store, string section, string item) {   // remove an item
    Store* st = findStore(store);        // find the store
    if (st == NULL) {                    // not found
        cout << "Store not found" << endl;
        return;                          // stop
    }
    Section* sc = findSection(st, section);      // find the section
    if (sc == NULL) {                    // not found
        cout << "Section not found" << endl;
        return;                          // stop
    }
    Item* cur = sc->items;               // current item
    Item* prev = NULL;                   // item before current
    while (cur != NULL && cur->name != item) {   // search the item
        prev = cur;                      // remember previous
        cur = cur->next;                 // move forward
    }
    if (cur == NULL) {                   // not found
        cout << "Item not found" << endl;
        return;                          // stop
    }
    if (prev == NULL)                    // item is the first one
        sc->items = cur->next;           // head changes
    else
        prev->next = cur->next;          // previous skips the item
    delete cur;                          // free memory
}

void showItems(Section* sc) {            // prints all items of a section
    if (sc->items == NULL)               // no items
        cout << "    (empty)" << endl;
    Item* t = sc->items;                 // start from first item
    while (t != NULL) {                  // till end
        cout << "    " << t->name << " (qty " << t->qty << ")" << endl;
        t = t->next;                     // move forward
    }
}

void showSection(string store, string section) {   // display items of a section
    Store* st = findStore(store);        // find the store
    if (st == NULL) {                    // not found
        cout << "Store not found" << endl;
        return;                          // stop
    }
    Section* sc = findSection(st, section);      // find the section
    if (sc == NULL) {                    // not found
        cout << "Section not found" << endl;
        return;                          // stop
    }
    cout << store << " / " << section << ":" << endl;
    showItems(sc);                       // print the items
}

void showStore(string store) {           // display all items of a store
    Store* st = findStore(store);        // find the store
    if (st == NULL) {                    // not found
        cout << "Store not found" << endl;
        return;                          // stop
    }
    cout << "Store: " << st->name << " (" << st->city << ")" << endl;
    Section* sc = st->sections;          // start from first section
    while (sc != NULL) {                 // go through all sections
        cout << "  Section: " << sc->name << endl;
        showItems(sc);                   // print its items
        sc = sc->next;                   // next section
    }
}

void freeInventory() {                   // deletes everything in inventory
    while (stores != NULL) {             // every store
        Store* st = stores;              // current store
        stores = stores->next;           // move forward
        while (st->sections != NULL) {   // every section
            Section* sc = st->sections;  // current section
            st->sections = sc->next;     // move forward
            while (sc->items != NULL) {  // every item
                Item* it = sc->items;    // current item
                sc->items = it->next;    // move forward
                delete it;               // delete item
            }
            delete sc;                   // delete section
        }
        delete st;                       // delete store
    }
}

// ---- DLL Task 4: theatre seats pattern ----
// Seat i is swapped with seat (n+1-i) only for even i. First and last stay same
void seatPattern(DNode* head, DNode* tail, int n) {
    if (n < 4)                           // too small to change anything
        return;                          // stop
    DNode* l = head->next;               // left pointer starts at seat 2
    DNode* r = tail->prev;               // right pointer starts at seat n-1
    int i = 2;                           // position of left pointer
    while (i < n + 1 - i) {              // till we reach the centre
        if (i % 2 == 0) {                // swap only on even positions
            string temp = l->data;       // swap the two values
            l->data = r->data;           // left gets right value
            r->data = temp;              // right gets left value
        }
        l = l->next;                     // left moves forward
        r = r->prev;                     // right moves backward
        i++;                             // next position
    }
}

// ======================= CIRCULAR LINKED LIST =======================

// ---- Josephus problem ----
// Algorithm: make a circle of N nodes, count M nodes and delete the Mth, repeat
int josephus(int N, int M) {
    Node* head = makeNode(1);            // first person
    Node* tail = head;                   // last person
    for (int i = 2; i <= N; i++) {       // add the other persons
        tail->next = makeNode(i);        // add at the end
        tail = tail->next;               // move tail
    }
    tail->next = head;                   // join last with first to make circle
    Node* prev = tail;                   // person before current
    Node* cur = head;                    // current person
    while (cur->next != cur) {           // till only one is left
        for (int c = 1; c < M; c++) {    // skip M-1 persons
            prev = cur;                  // move prev forward
            cur = cur->next;             // move cur forward
        }
        cout << "  killed: " << cur->data << endl;
        prev->next = cur->next;          // remove the Mth person
        delete cur;                      // free memory
        cur = prev->next;                // start counting from next person
    }
    int ans = cur->data;                 // the one who survived
    delete cur;                          // free the last node
    return ans;                          // safe position
}

// ---- Round robin task scheduler ----
struct Task {                            // one task
    string name;                         // task name
    int priority;                        // task priority
    string status;                       // pending / in-progress / completed
    Task* next;                          // next task (last one points to first)
};

Task* tTail = NULL;                      // last task, tTail->next is the head
Task* tCur = NULL;                       // task given last time

void addTask(string name, int priority, string status) {   // add task at the end
    Task* n = new Task;                  // new task
    n->name = name;                      // set name
    n->priority = priority;              // set priority
    n->status = status;                  // set status
    if (tTail == NULL) {                 // list is empty
        n->next = n;                     // points to itself
        tTail = n;                       // it is the tail
    } else {
        n->next = tTail->next;           // new task points to head
        tTail->next = n;                 // old tail points to new task
        tTail = n;                       // new task is the tail
    }
}

void removeTask(string name) {           // remove task by name
    if (tTail == NULL) {                 // no tasks
        cout << "No tasks" << endl;
        return;                          // stop
    }
    Task* prev = tTail;                  // task before current
    Task* cur = tTail->next;             // start from head
    do {
        if (cur->name == name) {         // found the task
            if (cur->next == cur) {      // it is the only task
                tTail = NULL;            // list becomes empty
                tCur = NULL;             // nothing is current
            } else {
                prev->next = cur->next;  // previous skips this task
                if (cur == tTail)        // removing the tail
                    tTail = prev;        // previous is new tail
                if (cur == tCur)         // removing current task
                    tCur = prev;         // continue after previous
            }
            delete cur;                  // free memory
            return;                      // done
        }
        prev = cur;                      // move prev forward
        cur = cur->next;                 // move cur forward
    } while (prev != tTail);             // one full round
    cout << "Task not found" << endl;
}

Task* getNextTask() {                    // gives next pending task
    if (tTail == NULL)                   // no tasks
        return NULL;                     // nothing to give
    Task* t;                             // task we are checking
    if (tCur == NULL)                    // nothing given before
        t = tTail->next;                 // start from head
    else
        t = tCur->next;                  // start after the last given task
    Task* start = t;                     // to know when one round is complete
    do {
        if (t->status == "Pending") {    // found a pending task
            tCur = t;                    // remember it
            return t;                    // give it back
        }
        t = t->next;                     // skip to next task
    } while (t != start);                // one full round
    return NULL;                         // no pending task at all
}

void showTasks() {                       // display all tasks
    if (tTail == NULL) {                 // no tasks
        cout << "No tasks" << endl;
        return;                          // stop
    }
    Task* t = tTail->next;               // start from head
    do {
        cout << "  " << t->name << " | priority " << t->priority
             << " | " << t->status << endl;
        t = t->next;                     // move forward
    } while (t != tTail->next);          // until we are back at head
}

void updateStatus(string name, string status) {   // change status of a task
    if (tTail == NULL)                   // no tasks
        return;                          // nothing to update
    Task* t = tTail->next;               // start from head
    do {
        if (t->name == name) {           // found it
            t->status = status;          // change status
            cout << "  " << t->name << " is now " << t->status << endl;
            return;                      // done
        }
        t = t->next;                     // move forward
    } while (t != tTail->next);          // one full round
    cout << "Task not found" << endl;
}

void freeTasks() {                       // delete all tasks
    if (tTail == NULL)                   // already empty
        return;                          // nothing to do
    Task* t = tTail->next;               // start from head
    tTail->next = NULL;                  // break the circle
    while (t != NULL) {                  // delete one by one
        Task* d = t;                     // node to delete
        t = t->next;                     // move forward first
        delete d;                        // delete it
    }
    tTail = NULL;                        // list is empty now
    tCur = NULL;                         // no current task
}

// ============================== MAIN ==============================

int main() {
    // ---------- Singly linked list tasks ----------
    cout << "--- SLL 1: reverse print ---" << endl;
    Node* h = NULL;                      // empty list
    for (int i = 1; i <= 5; i++)         // make 1 2 3 4 5
        addEnd(h, i);                    // add to the list
    show(h);                             // original list
    printReverse(h);                     // print reversed
    cout << endl;
    show(h);                             // list is not changed
    freeList(h);                         // delete list

    cout << "\n--- SLL 2: reverse list ---" << endl;
    h = NULL;                            // new list
    for (int i = 10; i <= 50; i += 10)   // make 10 20 30 40 50
        addEnd(h, i);                    // add to the list
    show(h);                             // before
    h = reverseList(h);                  // reverse it
    show(h);                             // after
    freeList(h);                         // delete list

    cout << "\n--- SLL 3: remove duplicate contacts ---" << endl;
    int c[] = {5, 3, 5, 8, 3, 9, 5, 8};  // test values
    h = NULL;                            // new list
    for (int i = 0; i < 8; i++)          // add all values
        addEnd(h, c[i]);                 // add to the list
    show(h);                             // before
    removeDuplicates(h);                 // remove duplicates
    show(h);                             // after
    freeList(h);                         // delete list

    cout << "\n--- SLL 4: detect loop ---" << endl;
    h = NULL;                            // new list
    for (int i = 1; i <= 5; i++)         // make 1 2 3 4 5
        addEnd(h, i);                    // add to the list
    cout << "Loop in normal list? " << (hasLoop(h) ? "Yes" : "No") << endl;
    Node* last = h;                      // find the last node
    while (last->next != NULL)           // till the end
        last = last->next;               // move forward
    last->next = h->next->next;          // last node points back to node 3
    cout << "Loop in faulty list? " << (hasLoop(h) ? "Yes" : "No") << endl;
    last->next = NULL;                   // remove the loop before deleting
    freeList(h);                         // delete list

    cout << "\n--- SLL 5: middle friend ---" << endl;
    h = NULL;                            // odd length list
    for (int i = 1; i <= 5; i++)         // make 1 2 3 4 5
        addEnd(h, i);                    // add to the list
    show(h);                             // print list
    cout << "Middle = " << findMiddle(h)->data << endl;
    freeList(h);                         // delete list
    h = NULL;                            // even length list
    for (int i = 1; i <= 6; i++)         // make 1 2 3 4 5 6
        addEnd(h, i);                    // add to the list
    show(h);                             // print list
    cout << "Middle = " << findMiddle(h)->data << endl;
    freeList(h);                         // delete list

    cout << "\n--- SLL 6: even and odd prices ---" << endl;
    int p[] = {12, 7, 4, 9, 20, 15, 6};  // fruit prices
    h = NULL;                            // new list
    for (int i = 0; i < 7; i++)          // add all prices
        addEnd(h, p[i]);                 // add to the list
    show(h);                             // original
    Node* ev;                            // even list
    Node* od;                            // odd list
    splitEvenOdd(h, ev, od);             // split them
    cout << "Even: "; show(ev);          // print even list
    cout << "Odd : "; show(od);          // print odd list
    freeList(ev);                        // delete even list
    freeList(od);                        // delete odd list

    cout << "\n--- SLL 7: reverse both halves ---" << endl;
    h = NULL;                            // new list
    for (int i = 1; i <= 8; i++)         // make 1 to 8
        addEnd(h, i);                    // add to the list
    show(h);                             // before
    h = reverseHalves(h);                // reverse halves
    show(h);                             // after
    freeList(h);                         // delete list

    cout << "\n--- SLL 8: remove duplicate stamps ---" << endl;
    int s[] = {101, 102, 101, 103, 102, 104, 104};   // stamp designs
    h = NULL;                            // new list
    for (int i = 0; i < 7; i++)          // add all designs
        addEnd(h, s[i]);                 // add to the list
    show(h);                             // before
    removeDuplicates(h);                 // remove duplicates
    show(h);                             // after
    freeList(h);                         // delete list

    cout << "\n--- SLL 9: delete all copies of an id ---" << endl;
    int b[] = {7, 7, 1, 7, 2, 3, 7, 7};  // book ids
    h = NULL;                            // new list
    for (int i = 0; i < 8; i++)          // add all ids
        addEnd(h, b[i]);                 // add to the list
    show(h);                             // before
    h = deleteAll(h, 7);                 // delete all 7s
    show(h);                             // after
    freeList(h);                         // delete list

    cout << "\n--- SLL 10: swap in pairs ---" << endl;
    h = NULL;                            // new list
    for (int i = 1; i <= 6; i++)         // make 1 to 6
        addEnd(h, i);                    // add to the list
    show(h);                             // before
    h = swapPairs(h);                    // swap pairs
    show(h);                             // after
    freeList(h);                         // delete list

    // ---------- Doubly linked list tasks ----------
    cout << "\n--- DLL 1: swap desks ---" << endl;
    DNode* dh = NULL;                    // head of list
    DNode* dt = NULL;                    // tail of list
    string desks[] = {"Alice", "Bob", "Charlie", "Dana", "Eva", "Frank"};   // names
    for (int i = 0; i < 6; i++)          // add all names
        dAdd(dh, dt, desks[i]);          // add to the list
    dShow(dh);                           // before
    swapDesks(dh, dt);                   // swap from both ends
    dShow(dh);                           // after
    dFree(dh);                           // delete list

    cout << "\n--- DLL 2: music player ---" << endl;
    addSong("Song A");                   // add songs
    addSong("Song B");
    addSong("Song C");
    addSong("Song D");
    nowPlaying();                        // first song
    nextSong();                          // go to B
    nextSong();                          // go to C
    prevSong();                          // back to B
    removeSong("Song C");                // delete C
    nextSong();                          // goes to D
    nextSong();                          // no more songs
    dFree(pHead);                        // delete playlist

    cout << "\n--- DLL 3: inventory ---" << endl;
    addStore("MegaMart-Lahore", "Lahore");        // add stores
    addStore("MegaMart-Karachi", "Karachi");
    addSection("MegaMart-Lahore", "Toys");        // add sections
    addSection("MegaMart-Lahore", "Grocery");
    addSection("MegaMart-Karachi", "Fruits");
    addItem("MegaMart-Lahore", "Toys", "Lego", 15);          // add items
    addItem("MegaMart-Lahore", "Toys", "Teddy Bear", 30);
    addItem("MegaMart-Lahore", "Grocery", "Rice", 100);
    addItem("MegaMart-Karachi", "Fruits", "Mango", 80);
    showSection("MegaMart-Lahore", "Toys");       // items of one section
    removeItem("MegaMart-Lahore", "Toys", "Teddy Bear");     // remove an item
    showSection("MegaMart-Lahore", "Toys");       // after removing
    showStore("MegaMart-Lahore");                 // all items of a store
    showStore("MegaMart-Karachi");                // all items of other store
    freeInventory();                     // delete everything

    cout << "\n--- DLL 4: theatre seats ---" << endl;
    dh = NULL;                           // new list
    dt = NULL;                           // new list
    for (int i = 1; i <= 9; i++)         // seats 1 to 9
        dAdd(dh, dt, to_string(i));      // add to the list
    dShow(dh);                           // before
    seatPattern(dh, dt, 9);              // apply the pattern
    dShow(dh);                           // after
    dFree(dh);                           // delete list

    // ---------- Circular linked list tasks ----------
    cout << "\n--- CLL 1: Josephus (N=7, M=3) ---" << endl;
    int safe = josephus(7, 3);           // run the game first
    cout << "Safe position = " << safe << endl;

    cout << "\n--- CLL 2: task scheduler ---" << endl;
    addTask("Design", 2, "Pending");     // add tasks
    addTask("Coding", 1, "Pending");
    addTask("Testing", 3, "Pending");
    addTask("Deploy", 4, "Pending");
    showTasks();                         // show all
    updateStatus("Coding", "Completed"); // change status
    updateStatus("Testing", "In-progress");
    for (int i = 0; i < 4; i++) {        // ask for next task a few times
        Task* t = getNextTask();         // get next pending task
        if (t != NULL)
            cout << "  next -> " << t->name << endl;
        else
            cout << "  no pending task" << endl;
    }
    removeTask("Design");                // remove a task
    showTasks();                         // show again
    updateStatus("Deploy", "Completed");
    if (getNextTask() == NULL)           // nothing left to run
        cout << "  no pending task" << endl;
    freeTasks();                         // delete all tasks

    return 0;                            // end of program
}
